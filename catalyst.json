{
  "functions": {
    "targets": [
      "spikra_document_upload",
      "spikra_document_process",
      "spikra_ai_analysis_v2",
      "spikra_experience_generate",
      "spikra_experience_deploy",
      "spikra_process_status",
      "spikra_experience_list",
      "proposal-api",
      "proposal-discovery",
      "proposal-processor",
      "workdrive-auth"
    ],
    "ignore": [
      "**/*.log"
    ],
    "source": "functions"
  },
  "apig": {
    "rules": "catalyst-user-rules.json",
    "enabled": true
  },
  "slate": [
    {
      "name": "spikra-experience",
      "source": "slate/spikra-experience"
    },
    {
      "name": "spikra-w2-proposal",
      "source": "slate/spikra-w2-proposal"
    }
  ]
}
