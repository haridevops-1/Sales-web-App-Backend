{
  "functions": {
    "targets": [
      "document-upload",
      "document-process",
      "document-analysis",
      "experience-generate",
      "experience-deploy",
      "process-status",
      "experience-list",
      "proposal-api-w2",
      "proposal-discovery-w2",
      "proposal-processor-w2",
      "workdrive-auth",
      "app-auth"
    ],
    "ignore": [
      "**/*.log"
    ],
    "source": "functions"
  },
  "apig": {
    "rules": "catalyst-user-rules.json",
    "enabled": true
  },
  "slate": [
    {
      "name": "spikra-experience",
      "source": "slate/spikra-experience"
    },
    {
      "name": "spikra-w2-proposal",
      "source": "slate/spikra-w2-proposal"
    }
  ]
}
