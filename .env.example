# ==============================================================================
# SPIKRA CUSTOMER EXPERIENCE ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the .env file with real secrets to version control.
# ==============================================================================

# Zoho Zia Agent Endpoint (Zoho Zia Agents)
# Deployed Zia Agent endpoint for customer document analysis and showcase orchestration
ZIA_AGENT_ENDPOINT=[PASTE ZIA AGENT URL HERE]

# Optional Zia Agent Authentication Token / API Key (if authentication is required).
# Keep the value blank here. Set the real value only in .env or Catalyst Console.
ZIA_AGENT_AUTH_TOKEN=
# ZIA_AGENT_API_KEY=

# Slate App URL Domain for Customer Interactive Proposals
# Default: https://spikra-ai-proposal.onslate.com
SLATE_APP_URL=https://spikra-ai-proposal.onslate.com

# Zoho Catalyst Project & Environment Configuration (Optional for local CLI scripts)
CATALYST_PROJECT_ID=822000000769001
CATALYST_PROJECT_NAME=Spikra-AI-Proposal
CATALYST_ENV_ID=698386704
CATALYST_ENV_NAME=Development

# Base Catalyst Directory Path (Optional, defaults to project root)
# CATALYST_DIR=.
