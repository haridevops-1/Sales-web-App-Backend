# Reference for the environment variables the deployed functions read.
#
# Nothing here is loaded at runtime: Catalyst functions get their variables from the Catalyst
# Console (Functions > <function> > Environment Variables) and, for NON-SECRET values only, from
# each function's catalyst-config.json. Never put a secret in catalyst-config.json, source code,
# a README or the frontend. A local .env is git-ignored.
#
# There is no Claude/Anthropic/LLM API key anywhere in this project. The AI runs inside the
# deployed Zia Agents, authenticated through the Catalyst Connection named in
# PROPOSAL_ZIA_CONNECTION_LINK_NAME - no key or token is stored by this code.

# ---- SECRETS: set in the Catalyst Console only ---------------------------------------------
# One Zoho API Console client (Server-based Application) is used for both sign-in and WorkDrive.
#   app-auth, workdrive-auth, proposal-discovery, proposal-processor, spikra_document_upload
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Signs the short-lived OAuth state.          needed by: app-auth, workdrive-auth
# Generate with: openssl rand -hex 32
STATE_SIGNING_SECRET=
# Encrypts WorkDrive tokens stored at rest.   needed by: workdrive-auth, proposal-discovery,
# proposal-processor, spikra_document_upload. MUST differ from STATE_SIGNING_SECRET.
TOKEN_ENCRYPTION_KEY=

# ---- NON-SECRET (kept in each function's catalyst-config.json) -----------------------------
# Redirect URIs - register BOTH on the Zoho client, exactly as written here:
#   <api-domain>/auth/callback        (app-auth)
#   <api-domain>/workdrive/callback   (workdrive-auth)
ZOHO_LOGIN_REDIRECT_URI=
ZOHO_WORKDRIVE_REDIRECT_URI=
# Data centre used to start sign-in: accounts.zoho.com | .in | .eu | .com.au | .jp | .sa | .com.cn
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Only these email domains may sign in (comma-separated).  needed by: app-auth
ALLOWED_EMAIL_DOMAINS=spikra.com
# Browser origins allowed to call the API (also add each as an Authorised Domain in the Console).
ALLOWED_ORIGINS=
# Workspace 1
ZIA_AGENT_ENDPOINT=
SLATE_APP_URL=
API_BASE_URL=
# Workspace 2
PROPOSAL_ZIA_AGENT_ENDPOINT=
PROPOSAL_ZIA_CONNECTION_LINK_NAME=
PROPOSAL_SLATE_APP_URL=
# Optional: contact line in the footer of generated showcases
PROPOSAL_CONTACT_EMAIL=
PROPOSAL_CONTACT_PHONE=
