# Template listing every environment variable the deployed functions read. Contains NO values.
#
# Copy this file to .env (git-ignored, excluded from deploys) and fill in every value.
# `npm run deploy` (scripts/deploy.js) reads .env, writes each function's variables into its
# catalyst-config.json for the deploy only, builds the Slate config.js from API_BASE_URL, then
# restores the committed, value-free files. Catalyst resets a function's Console variables to the
# config on every deploy, so .env is the single source of truth. Which function gets which
# variable is listed (names only) in scripts/function-env.json. Never commit real values.
#
# No Claude/Anthropic/LLM API key exists in this project: the AI runs inside the deployed Zia
# Agents, authenticated through the Catalyst Connection named in *_CONNECTION_LINK_NAME.

# ==== SECRETS ===============================================
# One Zoho API Console client (Server-based Application) serves both sign-in and WorkDrive.
#   needed by: app-auth, workdrive-auth, proposal-discovery-w2, proposal-processor-w2, document-upload
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
# Signs the short-lived OAuth state. Generate with: openssl rand -hex 32
#   needed by: app-auth, workdrive-auth
STATE_SIGNING_SECRET=
# Encrypts WorkDrive tokens at rest. Generate with: openssl rand -hex 32
# MUST differ from STATE_SIGNING_SECRET.
#   needed by: workdrive-auth, proposal-discovery-w2, proposal-processor-w2, document-upload
TOKEN_ENCRYPTION_KEY=
# workdrive-auth signs its OAuth state with its own secret (optional; falls back to STATE_SIGNING_SECRET).
STATE_SIGNING_SECRET_WORKDRIVE_AUTH=

# ==== NON-SECRET but identifying (URLs, IDs, bucket names) - also kept only in .env ================================
# OAuth redirect URIs - register BOTH on the Zoho client exactly as written:
#   <api-domain>/auth/callback        (app-auth)
#   <api-domain>/workdrive/callback   (workdrive-auth)
ZOHO_LOGIN_REDIRECT_URI=
ZOHO_WORKDRIVE_REDIRECT_URI=
# Data centre: https://accounts.zoho.com | .in | .eu | .com.au | .jp | .sa | .com.cn
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Comma-separated email domains allowed to sign in.            needed by: app-auth
ALLOWED_EMAIL_DOMAINS=spikra.com
# Comma-separated browser origins allowed to call the API (also add each as an Authorised Domain).
ALLOWED_ORIGINS=

# Stratus bucket names (per environment)
PROCESS_BUCKET_NAME=
GENERATED_BUCKET_NAME=
PROPOSAL_DOCUMENTS_BUCKET_NAME=

# Workspace 1 (experience generation)
ZIA_AGENT_ENDPOINT=
ZIA_AGENT_CONNECTION_LINK_NAME=
SLATE_APP_URL=
API_BASE_URL=

# Workspace 2 (proposals)
PROPOSAL_ZIA_AGENT_ENDPOINT=
PROPOSAL_ZIA_CONNECTION_LINK_NAME=
PROPOSAL_SLATE_APP_URL=
# Optional tuning (defaults: no input cap - the full document is sent; built-in timeout)
PROPOSAL_ZIA_MAX_INPUT_CHARS=
PROPOSAL_ZIA_TIMEOUT_MS=
# Optional contact line in the footer of generated showcases
PROPOSAL_CONTACT_EMAIL=
PROPOSAL_CONTACT_PHONE=
