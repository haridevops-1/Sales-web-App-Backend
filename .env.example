# ==============================================================================
# SPIKRA CUSTOMER EXPERIENCE ENGINE — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and provide your actual configuration values.
# NEVER commit the .env file with real secrets to version control.
# ==============================================================================

# Zoho Zia Agent Endpoint (Zoho Zia Agents)
# Deployed Zia Agent endpoint for customer document analysis and showcase orchestration
ZIA_AGENT_ENDPOINT=[PASTE ZIA AGENT URL HERE]

# Optional Zia Agent Authentication Token / API Key (if authentication is required).
# Keep the value blank here. Set the real value only in .env or Catalyst Console.
ZIA_AGENT_AUTH_TOKEN=
# ZIA_AGENT_API_KEY=

# Optional Zia Agent identifier, only needed if your deployed Agent's invocation
# contract requires an explicit agent id in the request body alongside the endpoint URL.
# Leave blank if the endpoint URL alone is sufficient (the common case).
ZIA_AGENT_ID=

# --------------------------------------------------------------------------
# Claude (LLM) configuration — NOT used by this Catalyst backend.
# Claude is configured directly inside the deployed Zia Agent (Zoho Zia Agent
# Studio → Agent → Model settings), not in this repository. It is listed here
# only as a reference placeholder for where that configuration lives.
# Do NOT wire these into any Catalyst function — Function 3 and Function 4
# must never call Claude/Anthropic directly.
# CLAUDE_MODEL=[PASTE CLAUDE MODEL HERE]
# CLAUDE_API_KEY=[PASTE CLAUDE API KEY HERE]
# --------------------------------------------------------------------------

# Slate App URL Domain for Customer Interactive Proposals
# Default: https://spikra-ai-proposal.onslate.com
SLATE_APP_URL=https://spikra-ai-proposal.onslate.com

# --------------------------------------------------------------------------
# Workspace 2 (Solution Proposals) — Zoho WorkDrive per-user OAuth.
# There is no separate app login - clicking "Open WorkDrive" goes straight to Zoho's
# own login/consent page, which IS the identity check. This is a real OAuth 2.0
# self-client registered in Zoho API Console, separate from the "workdrive_connection"
# Catalyst Connection (which only supports one shared credential set, not per-
# salesperson access). See workspace2-proposal/services/auth.
# --------------------------------------------------------------------------
WORKDRIVE_OAUTH_CLIENT_ID=[PASTE ZOHO API CONSOLE SELF-CLIENT ID HERE]
WORKDRIVE_OAUTH_CLIENT_SECRET=[PASTE ZOHO API CONSOLE SELF-CLIENT SECRET HERE]
WORKDRIVE_OAUTH_REDIRECT_URI=[PASTE THE proposal-workdrive-auth-v2 /callback URL HERE]

# Random secret used only to encrypt stored WorkDrive access/refresh tokens at rest.
# Not a Zoho credential - generate your own (e.g. `openssl rand -hex 32`).
WORKDRIVE_TOKEN_ENCRYPTION_KEY=

# Random secret used to sign the app's own session tokens, issued after a successful
# WorkDrive login so later requests know which salesperson is calling. Deliberately a
# DIFFERENT secret from WORKDRIVE_TOKEN_ENCRYPTION_KEY above - generate your own
# (e.g. `openssl rand -hex 32`), never a Zoho credential, never a password.
WORKDRIVE_SESSION_SECRET=

# Zoho accounts domain for OAuth (datacenter-specific: .com / .in / .eu / .com.au / .jp / .com.cn)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# WorkDrive API domain (datacenter-specific, matches ZOHO_ACCOUNTS_DOMAIN's region)
WORKDRIVE_API_DOMAIN=https://www.zohoapis.com/workdrive/api/v1

# Workspace 2 Zia Agent ("Customer Proposal Generation Agent") - separate from
# Workspace 1's Zia Agent, do not reuse ZIA_AGENT_ENDPOINT above for this.
PROPOSAL_ZIA_AGENT_ENDPOINT=[PASTE WORKSPACE 2 ZIA AGENT TRIGGER URL HERE]
PROPOSAL_ZIA_CONNECTION_LINK_NAME=[PASTE THE CATALYST CONNECTION LINK NAME FOR THIS AGENT]

# Zoho Catalyst Project & Environment Configuration (Optional for local CLI scripts)
CATALYST_PROJECT_ID=822000000769001
CATALYST_PROJECT_NAME=Spikra-AI-Proposal
CATALYST_ENV_ID=698386704
CATALYST_ENV_NAME=Development

# Base Catalyst Directory Path (Optional, defaults to project root)
# CATALYST_DIR=.
