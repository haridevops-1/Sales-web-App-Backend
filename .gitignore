# ---- Secrets & environment files (never commit) ----------------------------------------------
# Every .env variant is ignored; only the value-free template .env.example is tracked.
.env
.env.*
!.env.example
*.env
.envrc
*.secret
*.secrets
*.credentials
credentials.json
secrets.json
service-account*.json
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.netrc
.npmrc

# ---- Dependencies ----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---- Build artifacts, archives, backups ------------------------------------------------------
*.zip
*.tar.gz
*.tgz
dist/
build/
export_projects/
scratch/
*.bak
*.tmp
*.orig
*.rej

# ---- Logs & debugging ------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS files --------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# ---- Editor, IDE & local tool configuration --------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.claude/

# ---- Catalyst local/temporary files (Slate deployment config stays tracked) ------------------
.catalyst/logs/
.catalyst/tmp/
!slate/*/.catalyst/
!slate/*/.catalyst/**

# ---- Generated by `npm run sync:shared` - edit the root folders instead ----------------------
functions/*/shared/
functions/*/shared-auth/
functions/spikra_experience_generate_v2/template.html
slate/*/assets/shared/

# ---- Project-identifying local files (recreate with `catalyst init`; values live in .env) -----
.catalystrc
slate/*/config.js
